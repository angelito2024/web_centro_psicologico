# ============================================
# Centro Psicológico Magusa Arcoiris — Apache
# ============================================

AddDefaultCharset UTF-8
AddType image/webp .webp
AddType font/woff2 .woff2

# Compresión gzip de recursos de texto (reduce HTML/CSS/JS ~70-80 %)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml image/x-icon
</IfModule>

# Caché del navegador para visitas repetidas
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
</IfModule>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Archivos internos del proyecto: no deben poder descargarse desde el navegador
<FilesMatch "^(package(-lock)?\.json|purgecss\.config\.cjs|fiveserver\.config\.js|README\.md|CLAUDE\.md|mail-config.*\.php|\.gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /(\.git|node_modules|scripts)(/|$)
