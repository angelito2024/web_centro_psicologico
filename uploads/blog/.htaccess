# Esta carpeta solo debe servir imágenes. Se bloquea la ejecución de PHP
# como defensa adicional en caso de que llegue a subirse un archivo malicioso.
<FilesMatch "\.(php|php\d|phtml|pht)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
